# ── Copy this file to .env and fill in your values ───────────────────────────
# cp .env.example .env

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND SELECTION
# Options: "ollama" | "openai" | "lmstudio" | "llamacpp"
# ─────────────────────────────────────────────────────────────────────────────
LLM_BACKEND=ollama

# ─────────────────────────────────────────────────────────────────────────────
# OLLAMA (local — default)
# Download Ollama: https://ollama.com
# Pull a model:   ollama pull llama3.2
# ─────────────────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─────────────────────────────────────────────────────────────────────────────
# OPENAI (cloud — optional)
# Needed only if LLM_BACKEND=openai
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────────────────────
# LM STUDIO (local OpenAI-compatible server)
# Start LM Studio → Local Server → Start Server
# ─────────────────────────────────────────────────────────────────────────────
LMSTUDIO_HOST=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# ─────────────────────────────────────────────────────────────────────────────
# INFERENCE PARAMETERS
# ─────────────────────────────────────────────────────────────────────────────
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_CONTEXT_WINDOW=8192
LLM_STREAM=true

# ─────────────────────────────────────────────────────────────────────────────
# PATHS
# ─────────────────────────────────────────────────────────────────────────────
DOCUMENTS_DIR=documents
EMBEDDINGS_DIR=embeddings
MODELS_DIR=models
CHROMA_DIR=embeddings/chroma

# ─────────────────────────────────────────────────────────────────────────────
# SYSTEM PERSONA
# ─────────────────────────────────────────────────────────────────────────────
SYSTEM_PROMPT=You are a knowledgeable personal assistant. Be concise, accurate, and helpful.
ASSISTANT_NAME=Atlas

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/assistant.log
SAVE_CONVERSATIONS=true
CONVERSATIONS_DIR=data/conversations

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION DEPLOYMENT (P2 Sprint 1 — see docs/PRODUCTION_DEPLOYMENT_CHECKLIST.md)
# ─────────────────────────────────────────────────────────────────────────────
# ARGUS_ENV=production turns on fail-fast startup verification (the backend
# refuses to boot on ephemeral storage, missing auth secret, or unapplied RLS).
ARGUS_ENV=development
# Durable state root — point at the Railway volume mount path in production
# (e.g. /data). Unset locally = repo ./data (EPHEMERAL, dev only).
# ARGUS_DATA_DIR=/data
# Backend independently verifies every request's Supabase token (PH2). HS256
# shared secret from Supabase → Settings → API → JWT Secret.
# SUPABASE_JWT_SECRET=
# Anon key — used ONLY to prove RLS is applied at startup (PH5), never to write.
# SUPABASE_ANON_KEY=
